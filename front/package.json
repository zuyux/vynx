{
  "name": "vynx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "validate:env": "node scripts/validate-env.mjs",
    "predev": "npm run validate:env",
    "dev": "next dev",
    "prebuild": "npm run validate:env",
    "build": "next build",
    "prestart": "npm run validate:env",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "VYNX_ALIAS_REGISTRY_ENABLED=false tsx --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:registry": "E2E_ALIAS_REGISTRY=1 node e2e/run.mjs",
    "smoke:kora": "tsx --env-file=.env.local scripts/smoke-kora.ts"
  },
  "dependencies": {
    "@phantom/browser-sdk": "^2.0.2",
    "@phantom/react-sdk": "^2.0.2",
    "@shadcn/ui": "^0.0.4",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-standard-features": "^1.5.0",
    "@solana/web3.js": "^1.98.4",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@wallet-standard/app": "^1.1.1",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^16.3.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@solana/kit": "^8.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "litesvm": "^1.6.0",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
