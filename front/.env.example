# Server-only Supabase project settings. No Supabase variables are bundled for the browser.
# The anon key is for server-side auth and anonymous-access tests; never use a secret key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secret. Never rename this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Solana devnet only. The treasury must be a valid devnet wallet public key.
NEXT_PUBLIC_TREASURY_WALLET=your-devnet-solana-treasury-wallet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-only Kora node for fully sponsored devnet USDC tips.
# Required for USDC tipping; sponsors network fees and receiving token account creation.
# See ../docs/kora-usdc-tips.md for node setup and migration 008.
KORA_RPC_URL=
KORA_API_KEY=

# Public application origin (no trailing slash). Keep localhost for development.
# Vercel Production: https://vynx.me (must match wallet auth and Daily webhook registration).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: leave empty to connect with the Phantom browser extension.
# Set a real Portal App ID only for Google/Apple embedded wallet login.
NEXT_PUBLIC_PHANTOM_APP_ID=

# Registry is enabled by default. Apply migrations 006 and 023 before starting claims.
VYNX_ALIAS_REGISTRY_ENABLED=true
# Choose ONE server-only key source; never use a NEXT_PUBLIC_ prefix.
# Local development: absolute path to the ignored devnet sponsor keypair.
VYNX_ALIAS_SPONSOR_KEYPAIR_PATH=
# Hosting: secret environment variable containing the JSON array of 64 bytes.
VYNX_ALIAS_SPONSOR_SECRET_KEY=
# Rolling 24-hour registration + network-fee reservation budget, shared across app instances.
VYNX_ALIAS_SPONSOR_DAILY_BUDGET_LAMPORTS=1000000000

# Server-only error monitoring. Apply migration 011, then enable.
# Generate the local operator token with: npm run setup:monitoring
ERROR_MONITORING_ENABLED=false
ERROR_MONITORING_TOKEN=
# Optional HTTPS destination for outbound alerts; the built-in inbox works without it.
ERROR_ALERT_WEBHOOK_URL=
ERROR_ALERT_WEBHOOK_TOKEN=
# Retry scheduling: call POST /api/monitoring/dispatch every five minutes.

# Custom booking escrow: devnet only, disabled by default.
# Apply migrations 012–015 before enabling booking/video routes.
# The deployed program below is the hackathon devnet escrow; use your own program for another deployment.
# Explicit user-authorized hackathon exception for a hosted devnet demo.
# This flag never enables mainnet. Independent review remains future production work.
# Vercel hackathon deployment sets both HACKATHON and ESCROW_ENABLED to true.
VYNX_BOOKING_HACKATHON=false
VYNX_BOOKING_ESCROW_ENABLED=false
VYNX_BOOKING_PROGRAM_ID=B6FdE4aAcavkyh1u7UXadQXTQrGYmGWpPqKbfQ6sX7mY
# Server-only JSON array of the quote authority's 64 secret-key bytes.
# The key must match the deployed program config; store as a Vercel Production Secret.
VYNX_BOOKING_QUOTE_SECRET=

# Daily private calls (server only). Rooms have recording disabled in this P2.
# Set both Daily values as Vercel Production Secrets; never prefix them with NEXT_PUBLIC_.
DAILY_API_KEY=
# At least 32 random bytes encoded as base64; use the same hmac for Daily webhook registration.
DAILY_WEBHOOK_HMAC_BASE64=
# From front/: npm run setup:daily generates the local webhook secret without printing it.
# Configure the same secret in Vercel before registering:
# NEXT_PUBLIC_APP_URL=https://vynx.me npm run setup:daily -- --register
# Permanent webhook: https://vynx.me/api/daily/webhook
# See ../docs/private-calls.md. Never upload local test-wallet keys or recovery phrases to hosting.

# Development-only Iconsax MCP key for scripts/fetch-card-icons.mjs. Never expose to clients.
ICONSAX_MCP_KEY=

# Privy: both values enable email, Google, and Solana wallet authentication.
# Only the app ID is passed to the browser; the secret stays server-side.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Studio demo reservations only (apply migration 018 first). No payment or video.
VYNX_DEMO_BOOKINGS_ENABLED=false
